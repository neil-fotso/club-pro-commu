# Variables d'environnement pour Club Pro Commu Frontend

# =============================================================================
# 🔒 SÉCURITÉ - PAGE CRÉATION ADMIN
# =============================================================================

# Activer/désactiver la page secrète de création d'admin
# ⚠️ IMPORTANT: Désactivez en production après création du premier admin
# Valeurs: true | false
REACT_APP_ALLOW_ADMIN_CREATOR=false

# Mot de passe secret pour accéder à la page de création d'admin
# ⚠️ IMPORTANT: Utilisez un mot de passe très fort en production
# Exemple: VotreMotDePasseTresSecurise2024!
REACT_APP_ADMIN_SECRET=CreateAdmin2024!

# =============================================================================
# 🛠️ GUIDE D'UTILISATION EN PRODUCTION
# =============================================================================

# 1. Copiez ces variables dans votre plateforme de déploiement
# 2. Définissez REACT_APP_ALLOW_ADMIN_CREATOR=true
# 3. Définissez un REACT_APP_ADMIN_SECRET fort et unique
# 4. Déployez l'application
# 5. Accédez à /secret-admin-creator
# 6. Créez votre administrateur
# 7. ⚠️ IMPORTANT: Remettez REACT_APP_ALLOW_ADMIN_CREATOR=false
# 8. Redéployez pour sécuriser 